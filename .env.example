# Database — SQLite for development. To switch to PostgreSQL, set e.g.
# DATABASE_URL="postgresql://user:pass@localhost:5432/sports" and run `npm run db:push`.
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-output-of: openssl rand -base64 32"

# Signs QR Sports ID tokens (keep secret; rotating it invalidates issued QR codes)
QR_SIGNING_SECRET="replace-with-output-of: openssl rand -base64 32"

# Absolute path for private uploads (outside /public). Defaults to ./uploads
UPLOAD_DIR=""

# Demo mode shows OTPs on screen instead of sending SMS/email. Must be "false" in production.
DEMO_MODE="true"

# --- University Google sign-in (optional) -------------------------------------------------------
# Lets host-university students sign in with their university Google account (same email + password
# they use for university email). Leave blank to hide the button. The university's Google Workspace
# admin creates an OAuth client ("Internal" app) with redirect URI  <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
UNIVERSITY_EMAIL_DOMAIN=""   # the HOST university's domain, e.g. "mitwpu.edu.in"
# Visiting universities whose students may also sign in with their Google account (optional).
# Comma-separated "Name:domain" pairs. Their accounts are routed to the outside-student flow.
PARTNER_UNIVERSITY_DOMAINS=""  # e.g. "COEP Pune:coeptech.ac.in, SPPU:unipune.ac.in"

# --- Email notifications (optional) -------------------------------------------------------------
# Registration received / approved / rejected / on hold are always shown on the student's My status page.
# They are ALSO emailed (to students with a verified email) when both of these are set. Works with Google
# Workspace's SMTP relay or any email provider. Leave blank: no emails (demo mode only logs them).
SMTP_URL=""      # e.g. "smtps://user:app-password@smtp.gmail.com:465"
EMAIL_FROM=""    # e.g. "Sports Sphere <sports@mitwpu.edu.in>"
# Public address of the portal, used in links inside emails and certificates (defaults to NEXTAUTH_URL).
PUBLIC_BASE_URL=""
