// Portable schema: only features supported by both SQLite and PostgreSQL.
// The provider line is rewritten from DATABASE_URL by scripts/prisma-provider.mjs.
// Enumerations are stored as strings; allowed values live in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String // SUPER_ADMIN | ADMIN | OFFICIAL | MEDICAL | COACH (SUPER_ADMIN can do everything ADMIN can, plus manage admins)
  sportId      String? // coaches are linked to one sport
  sport        Sport?    @relation(fields: [sportId], references: [id], onDelete: SetNull)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  measurements Measurement[]
  weighIns     WeighIn[]
  matchDuties  MatchOfficial[]
}

model Student {
  id          String @id @default(cuid())
  status      String @default("DRAFT") // DRAFT | PENDING | VERIFIED | APPROVED | FLAGGED | REJECTED
  studentType String // OUR_INDIAN | OUTSIDE_INDIAN | INTERNATIONAL
  isOurUniversity Boolean @default(false)

  // One person = one profile. sha256 of (aadhaarLast4|name|dob) or (PASSPORT|nationality|number).
  identityKey String? @unique

  // Verified identity. Indian students: from DigiLocker or Aadhaar Offline e-KYC (never typed), or MANUAL:
  // typed with an uploaded Government ID, and verified only once an official has checked the original at the desk.
  fullName        String?
  dob             String? // YYYY-MM-DD, locked after verification
  dobSource       String? // DIGILOCKER | AADHAAR_OFFLINE | MANUAL | PASSPORT | ADMIN_CORRECTION
  dobLocked       Boolean   @default(false)
  identityVerifiedAt DateTime?
  gender          String?
  aadhaarLast4    String? // masked Aadhaar only — full number is never stored

  // Contact
  mobile   String?
  email    String?
  mobileVerified Boolean @default(false) // verified contacts are locked and usable for login
  emailVerified  Boolean @default(false)
  address  String?
  bloodGroup String?
  emergencyName  String?
  emergencyPhone String?

  // Academic
  prn            String?  @unique
  universityName String?
  collegeId      String?
  college        College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  schoolId       String? // host-university students only; comes from the ERP, never typed
  school         School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  collegeOfficeEmail String?
  course         String?
  year           Int?
  apaarId        String?

  // International
  passportNumber String?
  nationality    String?
  passportExpiry String? // YYYY-MM-DD
  mrzValid       Boolean?
  passportDeskVerified   Boolean   @default(false)
  passportDeskVerifiedAt DateTime?
  passportDeskVerifiedBy String?
  // Manual identity route: which Government ID was used, and the desk check of the original document.
  identityDocType          String? // AADHAAR_CARD | PASSPORT | PAN | DRIVING_LICENCE | VOTER_ID
  identityDocDeskVerified   Boolean   @default(false)
  identityDocDeskVerifiedAt DateTime?
  identityDocDeskVerifiedBy String?

  // Sports
  playingPosition String?

  // Medical & consent
  medicalConditions   String? // visible only to MEDICAL role
  declarationAccepted Boolean @default(false)
  privacyAccepted     Boolean @default(false)

  // Workflow
  wizardStep    Int       @default(0)
  statusReason  String? // reason shown to the student for FLAGGED / REJECTED
  submittedAt   DateTime?
  verifiedAt    DateTime?
  verifiedById  String?
  approvedAt    DateTime?
  approvedById  String?
  sportsId      String?   @unique // printed ID, e.g. SS-26-4F7K2Q
  deletionRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     Document[]
  registrations Registration[]
  checks        VerificationCheck[]
  measurements  Measurement[]
  weighIns      WeighIn[]
  deletionRequests DeletionRequest[]
  notifications    Notification[]
  dobCorrections   DobCorrection[]
  ageConcerns      AgeConcern[]
  changeRequests   EventChangeRequest[]
  reviewLock       ReviewLock?
  teamMembers      TeamMember[]
  captainOf        Team[]          @relation("captain")
  homeMatches      Match[]         @relation("homeStudent")
  awayMatches      Match[]         @relation("awayStudent")
  placings         Placing[]
  certificates     Certificate[]

  @@index([status])
  @@index([studentType])
  @@index([mobile])
  @@index([email])
  @@index([passportNumber])
}

model College {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  officeEmail    String?
  trusted        Boolean   @default(false)
  confirmedById  String?
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())
  students       Student[]
}

model Document {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         String // see DOC_TYPES
  source       String // UPLOAD | CAMERA | DIGILOCKER | ERP | PASSPORT | SEED
  storageKey   String   @unique // file name inside the private uploads folder
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([studentId, type])
}

model VerificationCheck {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String // see CHECK_TYPES
  passed    Boolean
  expected  String?
  actual    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([studentId])
}

model Sport {
  id                String   @id @default(cuid())
  name              String   @unique
  slug              String   @unique
  isWeightCategory  Boolean  @default(false)
  isTeam            Boolean  @default(false)
  positions         String? // comma-separated playing positions, if any
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  events           Event[]
  weightCategories WeightCategory[]
  coaches          StaffUser[]
}

model Event {
  id        String    @id @default(cuid())
  sportId   String
  sport     Sport     @relation(fields: [sportId], references: [id], onDelete: Cascade)
  // The tournament this event belongs to (its registration window applies). A tournament with events can't be deleted.
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  name      String
  gender    String // MALE | FEMALE | MIXED
  eventDate String? // YYYY-MM-DD
  venue     String?
  minEntries Int? // team sports: smallest squad that can take part
  maxEntries Int? // entry limit; new entries are refused once reached
  ageCategoryId String? // null = open to every age
  ageCategory   AgeCategory? @relation(fields: [ageCategoryId], references: [id], onDelete: SetNull)
  // Competition format: LEAGUE (round robin), KNOCKOUT (bracket) or RACE (ranked marks, e.g. 100 m). null = not set up.
  format          String?
  periods         Int?     // e.g. 2 halves
  periodMinutes   Int?
  shootout        Boolean  @default(false) // penalties / super over to break a knockout tie
  pointsWin       Int      @default(3)
  pointsDraw      Int      @default(1)
  rosterMin       Int?     // players per team sheet
  rosterMax       Int?
  resultsFinal    Boolean  @default(false) // podium confirmed; certificates can be issued
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  registrations Registration[]
  weighIns      WeighIn[]
  changeRequestsFrom EventChangeRequest[] @relation("changeFrom")
  changeRequestsTo   EventChangeRequest[] @relation("changeTo")
  teams              Team[]
  matches            Match[]
  placings           Placing[]
  certificates       Certificate[]
  announcements      Announcement[]

  @@index([tournamentId])
}

model AgeCategory {
  id        String @id @default(cuid())
  name      String @unique // U-19, U-21, U-23, Open
  maxAge    Int? // eligible if age on cutoff date < maxAge; null = Open
  sortOrder Int    @default(0)
  events    Event[]
}

model WeightCategory {
  id      String  @id @default(cuid())
  sportId String
  sport   Sport   @relation(fields: [sportId], references: [id], onDelete: Cascade)
  name    String
  gender  String // MALE | FEMALE
  minKg   Float?
  maxKg   Float?

  registrations Registration[]
}

model Registration {
  id               String          @id @default(cuid())
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventId          String
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weightCategoryId String?
  weightCategory   WeightCategory? @relation(fields: [weightCategoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@unique([studentId, eventId])
}

/// A locked DOB only changes when a SECOND admin approves the correction (maker–checker).
model DobCorrection {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromDob         String
  toDob           String
  reason          String
  status          String    @default("PENDING") // PENDING | APPLIED | DECLINED
  requestedById   String
  requestedByName String
  decidedById     String?
  decidedByName   String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([studentId])
}

/// Raised by a coach, official or medical officer who doubts an athlete's age. Never changes status by itself.
model AgeConcern {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason         String
  raisedById     String
  raisedByName   String
  raisedByRole   String
  status         String    @default("OPEN") // OPEN | UPHELD | DISMISSED
  resolution     String?
  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([studentId])
}

/// Student asks to swap one event for another after submitting. Withdrawals don't need one.
model EventChangeRequest {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromEventId      String
  fromEvent        Event     @relation("changeFrom", fields: [fromEventId], references: [id], onDelete: Cascade)
  toEventId        String
  toEvent          Event     @relation("changeTo", fields: [toEventId], references: [id], onDelete: Cascade)
  weightCategoryId String?
  reason           String
  status           String    @default("PENDING") // PENDING | APPROVED | DECLINED
  decidedById      String?
  decidedByName    String?
  decisionNote     String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([studentId])
}

/// Soft "being reviewed by" marker so two admins don't work on the same record. Expires after a few minutes.
model ReviewLock {
  studentId String   @id
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staffId   String
  staffName String
  since     DateTime @default(now())
  seenAt    DateTime @default(now())
}

/// Height/weight are entered only by an Official at the verification desk.
model Measurement {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  heightCm     Float
  weightKg     Float
  measuredById String
  measuredBy   StaffUser @relation(fields: [measuredById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([studentId, createdAt])
}

/// Event-day weigh-in for weight-category sports.
model WeighIn {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weightKg       Float
  withinCategory Boolean?
  categoryName   String?
  notes          String?
  recordedById   String
  recordedBy     StaffUser @relation(fields: [recordedById], references: [id])
  createdAt      DateTime  @default(now())

  @@index([studentId, eventId, createdAt])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  target     String // phone or email the code was sent to
  channel    String // SMS | EMAIL
  purpose    String // REGISTER | LOGIN
  codeHash   String
  meta       String? // JSON: { path, prn, ... }
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // STAFF | STUDENT | SYSTEM
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  studentId  String? // kept as plain string so history survives deletion
  entityType String?
  entityId   String?
  summary    String
  details    String? // JSON
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([studentId])
  @@index([action])
}

model DeletionRequest {
  id            String    @id @default(cuid())
  studentId     String?
  student       Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentLabel  String // name/PRN snapshot for the admin queue
  reason        String?
  status        String    @default("PENDING") // PENDING | COMPLETED | DECLINED
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

/// Host university structure: campus → schools. Teams can represent a school inside the university.
model Campus {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique // short code shown on tiles, e.g. KTH
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  schools   School[]
}

model School {
  id        String    @id @default(cuid())
  campusId  String
  campus    Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  code      String    @unique // matches the ERP's school code, e.g. CSE
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  students  Student[]
  teams     Team[]
}

/// A squad entered in one team event. Members must be APPROVED and registered for that event.
model Team {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  shortName String // scoreboards, max 5 chars
  // Who it represents: a school of the host university, or a college (outside institution), or the host university itself.
  schoolId  String?
  school    School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  collegeName String?
  captainId String?
  captain   Student?     @relation("captain", fields: [captainId], references: [id], onDelete: SetNull)
  lockedAt  DateTime? // roster frozen for the event
  createdAt DateTime     @default(now())
  members   TeamMember[]
  homeMatches Match[]    @relation("homeTeam")
  awayMatches Match[]    @relation("awayTeam")
  placings  Placing[]

  @@unique([eventId, name])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  shirt     Int?
  createdAt DateTime @default(now())

  @@unique([teamId, studentId])
}

/// One fixture. Sides are teams (team events) or athletes (individual head-to-head events).
model Match {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  division      String? // weight class for combat sports, e.g. "−74 kg"
  round         Int // 1-based; knockout: 1 = first round
  roundLabel    String // "Matchday 2", "Semi-final"
  slot          Int // position inside the round
  homeTeamId    String?
  homeTeam      Team?     @relation("homeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId    String?
  awayTeam      Team?     @relation("awayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  homeStudentId String?
  homeStudent   Student?  @relation("homeStudent", fields: [homeStudentId], references: [id], onDelete: SetNull)
  awayStudentId String?
  awayStudent   Student?  @relation("awayStudent", fields: [awayStudentId], references: [id], onDelete: SetNull)
  homeScore     Int?
  awayScore     Int?
  homeTiebreak  Int? // penalties / super over
  awayTiebreak  Int?
  status        String    @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | WALKOVER | POSTPONED | CANCELLED
  statusReason  String? // why a match was postponed or cancelled (shown publicly)
  courtId       String?
  court         Court?    @relation(fields: [courtId], references: [id], onDelete: SetNull)
  durationMin   Int? // planned length incl. changeover; used for clash checks (default from the event format)
  winner        String? // HOME | AWAY | DRAW
  scheduledAt   DateTime?
  venue         String?
  nextMatchId   String? // knockout: the winner moves here
  nextSide      String? // HOME | AWAY
  bye           Boolean   @default(false)
  scoredByName  String?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  scoreEvents   ScoreEvent[]
  officials     MatchOfficial[]

  @@index([eventId, round])
  @@index([courtId, scheduledAt])
}

/// Every live-scoring tap. clientId makes offline replays idempotent.
model ScoreEvent {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  clientId  String   @unique
  side      String // HOME | AWAY
  delta     Int // +1 point, -1 undo
  note      String?
  byId      String
  byName    String
  at        DateTime // when it happened on the scorer's device
  createdAt DateTime @default(now())

  @@index([matchId, at])
}

/// Final position in an event (podium and beyond). Medals come from positions 1–3.
model Placing {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  division  String? // weight class, if any
  position  Int
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mark      String? // time / distance / score for RACE events, e.g. "11.42 s"
  createdAt DateTime @default(now())

  @@index([eventId, position])
}

/// Tamper-evident certificate. The public /verify page re-computes the signature.
model Certificate {
  id         String    @id @default(cuid())
  code       String    @unique // CERT-26-XXXXXX
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind       String // PARTICIPATION | GOLD | SILVER | BRONZE
  // Frozen at issue time so later edits to the student or event can't silently change a certificate.
  recipient  String
  institution String
  title      String
  issuedAt   DateTime  @default(now())
  issuedById String
  revokedAt  DateTime?
  revokeReason String?
  signature  String

  division   String?

  @@unique([studentId, eventId, kind, division])
}

/// Notice to a role or to one event's athletes. Delivered in-app, and by SMS/WhatsApp when the mock channels are on.
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    String // EVERYONE | ATHLETES | EVENT | CAPTAINS | OFFICIALS | COACHES | MEDICAL
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channels    String   @default("IN_APP") // comma-separated: IN_APP,SMS,WHATSAPP
  recipients  Int      @default(0)
  createdById String
  createdByName String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// A competition such as "Hoop It Up 2027" or "Sports Summit 2027". Groups events, sets the registration window, and
/// keeps past seasons as history.
model Tournament {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  season    String // e.g. "2026-27"
  startDate String? // YYYY-MM-DD
  endDate   String? // YYYY-MM-DD
  /// Students can pick this tournament's events only between these times (null = no limit on that side).
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  status    String   @default("DRAFT") // DRAFT (being set up, registration closed) | ACTIVE | ARCHIVED (history, registration closed)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]

  @@index([status])
}

/// A personal notice to a student, shown in the portal and (when possible) emailed. Deleted with the student.
model Notification {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind        String // REGISTRATION_SUBMITTED | REGISTRATION_APPROVED | REGISTRATION_REJECTED | REGISTRATION_FLAGGED
  title       String
  body        String
  link        String?
  readAt      DateTime?
  emailStatus String    @default("NONE") // NONE (no verified email) | SENT | FAILED | NOT_CONFIGURED | DEMO
  emailError  String?
  createdAt   DateTime  @default(now())

  @@index([studentId, createdAt])
}

/// A place where matches are played, e.g. "Dronacharya Sports Complex".
model Venue {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  courts    Court[]
}

/// A court, field, pool or hall inside a venue. Matches are scheduled onto courts, and two matches can't overlap on one.
model Court {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  name      String // e.g. "Basketball Court 1"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  matches   Match[]

  @@unique([venueId, name])
}

/// Who officiates a match. A SCOREKEEPER may enter the live score for that match; a REFEREE runs it.
/// Officials see and score only the matches they are assigned to (admins can score any match).
model MatchOfficial {
  id           String    @id @default(cuid())
  matchId      String
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  staffId      String
  staff        StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  duty         String // SCOREKEEPER | REFEREE
  assignedById String
  createdAt    DateTime  @default(now())

  @@unique([matchId, staffId, duty])
  @@index([staffId])
}
